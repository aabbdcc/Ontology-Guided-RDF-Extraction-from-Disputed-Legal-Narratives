@prefix ex: <https://example.org/legal-kg/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:claim_D07 a ex:Claim ;
    ex:assertedBy ex:alma ;
    ex:concerns ex:transfer_p7 ;
    ex:derivedFrom ex:doc_D07 ;
    ex:hasQualification ex:loan ;
    ex:sourceText "Alma claims that transfer P7 was a loan." .

ex:claim_D12 a ex:Claim ;
    ex:assertedBy ex:falcon_ltd ;
    ex:concerns ex:transfer_p12 ;
    ex:derivedFrom ex:doc_D12 ;
    ex:hasQualification ex:gift ;
    ex:sourceText "Falcon Ltd claims that transfer P12 was a gift." .

ex:claim_D13 a ex:Claim ;
    ex:assertedBy ex:mira ;
    ex:concerns ex:transfer_q ;
    ex:derivedFrom ex:doc_D13 ;
    ex:hasQualification ex:loan ;
    ex:sourceText "Mira claims that Transfer Q was a loan." .

ex:claim_D14 a ex:Claim ;
    ex:assertedBy ex:northstar_ltd ;
    ex:concerns ex:transfer_q ;
    ex:derivedFrom ex:doc_D14 ;
    ex:hasQualification ex:investment ;
    ex:sourceText "Northstar Ltd claims that Transfer Q was an investment." .

ex:fact_D01 a ex:ObservedFact ;
    ex:concerns ex:payment_D01 ;
    ex:derivedFrom ex:doc_D01 ;
    ex:sourceText "On 12 March 2025, Alice transferred EUR 10,000 to Company C." .

ex:fact_D06 a ex:ObservedFact ;
    ex:concerns ex:payment_D06 ;
    ex:derivedFrom ex:doc_D06 ;
    ex:sourceText "On 2 August 2025, Company H transferred EUR 12,000 to Frank." .

ex:alice a ex:Person .

ex:alma a ex:Person .

ex:company_c a ex:Company .

ex:company_h a ex:Company .

ex:doc_D01 a ex:Document .

ex:doc_D06 a ex:Document .

ex:doc_D07 a ex:Document .

ex:doc_D12 a ex:Document .

ex:doc_D13 a ex:Document .

ex:doc_D14 a ex:Document .

ex:falcon_ltd a ex:Company .

ex:frank a ex:Person .

ex:gift a skos:Concept .

ex:investment a skos:Concept .

ex:mira a ex:Person .

ex:northstar_ltd a ex:Company .

ex:payment_D01 a ex:Payment ;
    ex:amount 10000.0 ;
    ex:currency "EUR" ;
    ex:date "2025-03-12"^^xsd:date ;
    ex:payer ex:alice ;
    ex:recipient ex:company_c .

ex:payment_D06 a ex:Payment ;
    ex:amount 12000.0 ;
    ex:currency "EUR" ;
    ex:date "2025-08-02"^^xsd:date ;
    ex:payer ex:company_h ;
    ex:recipient ex:frank .

ex:transfer_p12 a ex:DisputeMatter .

ex:transfer_p7 a ex:DisputeMatter .

ex:loan a skos:Concept .

ex:transfer_q a ex:DisputeMatter .

